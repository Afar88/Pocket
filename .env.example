# Celo mainnet only (chain ID 42220)
CELO_RPC=https://celo-rpc.publicnode.com

# Required before the worker will submit any transaction. Use your assigned Celo attribution code.
ATTRIBUTION_TAG=

# Deploy PocketRegistry to Celo mainnet, then set this address.
REGISTRY_ADDRESS=

# Generate a dedicated Altana session key in the Pocket web app.
# Copy it here only in your Render background worker's secret environment.
# Never put this value in the browser, source control, or a local committed file.
AGENT_PRIVATE_KEY=
