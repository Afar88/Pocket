# Celo mainnet only (chain ID 42220)
CELO_RPC=https://celo-rpc.publicnode.com

# Required before the worker will submit any transaction. Use your assigned Celo attribution code.
ATTRIBUTION_TAG=

# Deploy PocketRegistry to Celo mainnet, then set this address.
REGISTRY_ADDRESS=

# The worker's own EOA identity (used for ERC-8004 registration). Not a user
# session key — each owner's session key reaches the worker encrypted onchain.
AGENT_PRIVATE_KEY=

# The worker's X25519 decryption private key. Generate the pair once with
# `npm run keygen --workspace @pocket/agent`, put the private half here and the
# public half in the web service as AGENT_ENC_PUBLIC_KEY.
AGENT_ENC_PRIVATE_KEY=
AGENT_ENC_PUBLIC_KEY=

# Set to 1 for a single pass over due pockets and exit (used by the scheduler).
POCKET_RUN_ONCE=
